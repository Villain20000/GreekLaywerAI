# NomosAI staging environment template (plan item 3-2).
#
# Copy to `.env.staging`, replace EVERY value, then lock it down:
#
#   cp .env.staging.example .env.staging
#   chmod 600 .env.staging
#
# `.env.staging` is ignored by this repository's `.gitignore`. Still never
# commit a filled-in copy. Validate with `docker compose ... config -q`
# (without `-q`, compose prints resolved secret values).
#
# The values below are DUMMY PLACEHOLDERS. They are safe to commit and are
# intentionally not usable as secrets.
#
# Runbooks:
#   docs/staging-deployment.md    (full staging runbook)
#   docs/production-hardening.md  (TLS, *_FILE secrets, cache, feature flags)
#   docs/observability.md         (Prometheus/Alertmanager/Grafana/Loki)
#   docs/backup-restore.md        (backups, S3 offsite copy, restore)
#
# Secret files: any supported secret can be read from `<NAME>_FILE` instead of
# the plain variable (the file wins; trailing CR/LF stripped). Supported:
# DB_PASSWORD, JWT_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# SMTP_USER, SMTP_PASS. Compose interpolation still needs the plain variable,
# so keep a non-sensitive placeholder when using files.

# ── Public identity / ACME ──────────────────────────────────────────────
# DNS: an A (and AAAA, if used) record for this name must point at the
# staging host, and inbound TCP 80 + 443 must reach Traefik.
STAGING_DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com
# Default is the Let's Encrypt STAGING directory (untrusted certs, high rate
# limits). For a production-trusted cert on a stable staging domain use:
# STAGING_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
STAGING_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Host-side ports; only change these if 80/443 are already occupied.
STAGING_HTTP_PORT=80
STAGING_HTTPS_PORT=443
# Public origin baked into the frontend build (index.html, sitemap.xml,
# robots.txt). Changing it requires rebuilding the frontend image.
SITE_URL=https://staging.example.com

# ── Edge rate limiting (Traefik middleware labels) ─────────────────────
# Average/burst requests per second per client IP, plus concurrent
# in-flight requests. Long-lived SSE requests count once, not per event.
EDGE_RATE_LIMIT_AVERAGE=50
EDGE_RATE_LIMIT_BURST=100
EDGE_INFLIGHT_REQ_AMOUNT=100

# ── Database ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Changing this after the pgdata_staging volume exists requires ALTER USER
# inside PostgreSQL; see docs/staging-deployment.md ("Rotation").
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DB_PASSWORD
#DB_PASSWORD_FILE=/run/secrets/db_password

# ── Authentication ──────────────────────────────────────────────────────
# REQUIRED: 64+ random hex characters. Generate with:
#   openssl rand -hex 64
# Rotating this invalidates every issued JWT immediately (all users must
# log in again). It does not touch users.token_version.
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_64
#JWT_SECRET_FILE=/run/secrets/jwt_secret

# ── Email (sandbox SMTP is mandatory in staging) ────────────────────────
# NODE_ENV=production is set in compose, so the backend refuses to boot
# unless EMAIL_TRANSPORT=smtp, SMTP_HOST and EMAIL_FROM are present.
# Use a sandbox provider (Mailtrap, Mailpit, MailHog, …) that cannot deliver
# to real users. SMTP_USER/SMTP_PASS are optional for relays without auth.
EMAIL_FROM=NomosAI Staging <no-reply@staging.example.com>
SMTP_HOST=smtp.sandbox.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SANDBOX_SMTP_USER
SMTP_PASS=REPLACE_WITH_SANDBOX_SMTP_PASSWORD
#SMTP_USER_FILE=/run/secrets/smtp_user
#SMTP_PASS_FILE=/run/secrets/smtp_pass

# ── Stripe (TEST MODE ONLY) ────────────────────────────────────────────
# sk_test_... for real test-mode Checkout, or sk_test_mock for the built-in
# mock checkout (no Stripe calls). NEVER use sk_live_ in staging.
# Price IDs come from the Stripe Dashboard in test mode.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PRICE_ID_BASIC=price_REPLACE_ME_BASIC
STRIPE_PRICE_ID_PRO=price_REPLACE_ME_PRO
STRIPE_PRICE_ID_ENTERPRISE=price_REPLACE_ME_ENTERPRISE
# Webhook endpoint: https://${STAGING_DOMAIN}/api/billing/webhook
# Register it (with a real test key) via:
#   docker compose ... exec backend npm run stripe:webhook
# `stripe listen`/Dashboard gives you a whsec_... value. Leave empty when
# using sk_test_mock.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
#STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
#STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret

# ── Monitoring profile (only needed with --profile monitoring) ─────────
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_GRAFANA_PASSWORD
GRAFANA_PORT=3001

# ── Retention (days) ────────────────────────────────────────────────────
RETENTION_CONVERSATIONS_DAYS=365
RETENTION_DOCUMENTS_DAYS=365
RETENTION_AUDIT_LOG_DAYS=90
# Account deletion grace period (hours, 1-168); deletion can be cancelled
# until the scheduled deadline.
ACCOUNT_DELETION_GRACE_HOURS=24

# ── Optional tuning ─────────────────────────────────────────────────────
#WHISPER_MODEL=Systran/faster-whisper-base
#WHISPER_TIMEOUT_MS=120000
#OLLAMA_TIMEOUT_MS=120000
#LOG_LEVEL=info
#ADMIN_MAGIC_LINK_ENABLED=false
# Local OCR / optional Ollama vision path + scanned-PDF OCR.
#OCR_LANGUAGES=ell+eng
#OCR_TIMEOUT_MS=30000
#OCR_PDF_MAX_PAGES=10
#OCR_PDF_SCALE=2
#OCR_PDF_TIMEOUT_MS=120000
#OLLAMA_VISION_MODEL=
#OLLAMA_VISION_TIMEOUT_MS=120000
# A/B experiments (JSON; empty uses landing-hero 50/50) and optional Sentry.
#AB_EXPERIMENTS=
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=staging
#SENTRY_TRACES_SAMPLE_RATE=0
# Frontend Sentry is build-time: set sentryDsn in
# frontend/src/environments/environment.prod.ts and rebuild.
# Redis cache + feature flags (GET /api/config).
#RAG_CACHE_TTL_SECONDS=300
#PLANS_CACHE_TTL_SECONDS=3600
#CACHE_PREFIX=nomos:cache
#FEATURE_FLAGS=
# Live SSE token streaming (Redis pub/sub).
#AI_STREAM_TTL_MS=600000
#AI_STREAM_MAX_LOG_EVENTS=5000
#AI_STREAM_PUBLISH_TIMEOUT_MS=2000
#AI_STREAM_SUBSCRIBE_TIMEOUT_MS=5000
#AI_STREAM_REDIS_COOLDOWN_MS=30000
# Set false only when a dedicated worker process consumes the queue.
QUEUE_WORKER_ENABLED=true
#AI_QUERY_TIMEOUT_MS=120000
#AI_UPLOAD_MAX_BYTES=26214400

# Host path to the scraper output. The file must exist before `up`, because
# Docker bind-mounts a missing path as a directory. Use an absolute path or
# a path relative to this compose file.
#SCRAPED_LAWS_PATH=./scraped_laws.json

# ── Optional image pinning (reproducible deploys / rollback) ────────────
# Without these, compose builds local images tagged *:local. For rollbacks,
# push per-release tags to a registry and pin them here:
#STAGING_BACKEND_IMAGE=registry.example.com/nomosai/backend:2026-10-19
#STAGING_FRONTEND_IMAGE=registry.example.com/nomosai/frontend:2026-10-19

# ── Backups ─────────────────────────────────────────────────────────────
# The backup sidecar always writes to the backups_staging volume (/backups).
# Set BACKUP_S3_BUCKET to upload each dump to S3-compatible storage as well
# (see docs/backup-restore.md). Leave empty for local-only backups.
#BACKUP_S3_BUCKET=
#S3_REGION=
#S3_ENDPOINT=
#S3_FORCE_PATH_STYLE=false
#S3_PREFIX=nomosai/
#S3_SSE=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#AWS_REGION=
