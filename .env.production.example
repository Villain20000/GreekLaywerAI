# NomosAI production environment template.
#
# Copy to `.env.production`, replace EVERY value, then lock it down:
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Never commit a filled-in copy. Validate with:
#   docker compose -f docker-compose.prod.yml --env-file .env.production config -q
#
# Runbooks:
#   docs/production-hardening.md  (TLS, secrets, cache, feature flags)
#   docs/observability.md         (Prometheus, Alertmanager, Loki, Grafana)
#   docs/backup-restore.md        (pg_dump, S3 offsite copy, restore)
#   docs/staging-deployment.md    (staging stack)
#
# The values below are DUMMY PLACEHOLDERS. They are safe to commit and are
# intentionally not usable as credentials.
#
# Secret files: every supported secret may instead be read from a file by
# setting `<NAME>_FILE` (read, trailing CR/LF stripped, takes precedence over
# the plain variable): DB_PASSWORD, JWT_SECRET, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, SMTP_USER, SMTP_PASS. See
# docs/production-hardening.md → "Secrets from files". Compose interpolation
# still requires the plain variables below; file-only deployments are
# intended for Kubernetes/`docker run` (or set the plain value to a
# non-sensitive placeholder — the file always wins).

# ── Public identity / ACME ──────────────────────────────────────────────
# DNS: an A (and AAAA, if used) record for this name must point at the host,
# and inbound TCP 80 + 443 must reach Traefik.
DOMAIN=example.com
ACME_EMAIL=ops@example.com
# Let's Encrypt PRODUCTION directory. Keep the default unless testing a
# brand-new domain against the staging CA (untrusted certs).
PROD_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
HTTP_PORT=80
HTTPS_PORT=443

# ── Database ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DB_PASSWORD
#DB_PASSWORD_FILE=/run/secrets/db_password

# ── Authentication ──────────────────────────────────────────────────────
# REQUIRED: 64+ random hex characters. Generate with: openssl rand -hex 64
# Rotating this invalidates every issued JWT immediately.
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_64
#JWT_SECRET_FILE=/run/secrets/jwt_secret

# ── Application URLs / CORS ────────────────────────────────────────────
APP_BASE_URL=https://example.com
CORS_ORIGINS=https://example.com
# Public origin baked into the frontend build (index.html, sitemap.xml,
# robots.txt). Set this before `up --build`; changing it needs a rebuild.
SITE_URL=https://example.com
TRUST_PROXY=uniquelocal,loopback
LOG_LEVEL=info

# ── Edge rate limiting (Traefik middleware labels) ─────────────────────
# Average/burst requests per second per client IP, plus concurrent
# in-flight requests. SSE responses count once per request.
EDGE_RATE_LIMIT_AVERAGE=50
EDGE_RATE_LIMIT_BURST=100
EDGE_INFLIGHT_REQ_AMOUNT=100

# ── Email (mandatory SMTP in production) ───────────────────────────────
EMAIL_FROM=NomosAI <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
#SMTP_USER_FILE=/run/secrets/smtp_user
#SMTP_PASS_FILE=/run/secrets/smtp_pass

# ── Stripe (LIVE mode; key starts with sk_live_) ───────────────────────
# Webhook endpoint: https://${DOMAIN}/api/billing/webhook
# Register it (once) with:
#   docker compose ... exec backend npm run stripe:webhook
# The script prints the signing secret only when it creates the endpoint.
STRIPE_SECRET_KEY=REPLACE_WITH_LIVE_STRIPE_SECRET_KEY
STRIPE_PRICE_ID_BASIC=price_REPLACE_ME_BASIC
STRIPE_PRICE_ID_PRO=price_REPLACE_ME_PRO
STRIPE_PRICE_ID_ENTERPRISE=price_REPLACE_ME_ENTERPRISE
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
#STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
#STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret

# ── Caching (Redis; fail-open) ─────────────────────────────────────────
RAG_CACHE_TTL_SECONDS=300
PLANS_CACHE_TTL_SECONDS=3600
CACHE_PREFIX=nomos:cache

# ── Feature flags ──────────────────────────────────────────────────────
# Comma-separated. Bare names enable; name:false disables. Unspecified
# known flags default to enabled (billing, documents, audio, adminDocuments).
FEATURE_FLAGS=
# Example: FEATURE_FLAGS=documents:false,adminDocuments:false

# ── Daily quotas ───────────────────────────────────────────────────────
QUOTA_AI_BASIC=20
QUOTA_AI_PRO=60
QUOTA_AI_ENTERPRISE=120
QUOTA_DOCS_BASIC=10
QUOTA_DOCS_PRO=50
QUOTA_DOCS_ENTERPRISE=unlimited

# ── Retention (days) ───────────────────────────────────────────────────
RETENTION_CONVERSATIONS_DAYS=365
RETENTION_DOCUMENTS_DAYS=365
RETENTION_AUDIT_LOG_DAYS=90
# Account deletion grace period (hours, 1-168); deletion is scheduled, not
# immediate, and can be cancelled until the deadline.
ACCOUNT_DELETION_GRACE_HOURS=24

# ── A/B experiments (GET /api/config) ─────────────────────────────────
# JSON object with weighted variants; empty uses the landing-hero 50/50
# default. Assignment is client-side/deterministic; no exposure analytics.
AB_EXPERIMENTS=

# ── Sentry (optional; empty DSN disables the SDK) ─────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# Frontend Sentry is build-time: set sentryDsn/sentryTracesSampleRate in
# frontend/src/environments/environment.prod.ts and rebuild the image.

# ── Local AI / speech / OCR / vision ───────────────────────────────────
OLLAMA_TIMEOUT_MS=120000
AI_QUERY_TIMEOUT_MS=120000
AI_UPLOAD_MAX_BYTES=26214400
WHISPER_MODEL=Systran/faster-whisper-base
WHISPER_TIMEOUT_MS=120000
OCR_LANGUAGES=ell+eng
OCR_TIMEOUT_MS=30000
# Scanned-PDF OCR (page rasterization; encrypted PDFs are rejected).
OCR_PDF_MAX_PAGES=10
OCR_PDF_SCALE=2
OCR_PDF_TIMEOUT_MS=120000
# Empty disables the Ollama vision path (OCR is used instead).
OLLAMA_VISION_MODEL=
OLLAMA_VISION_TIMEOUT_MS=120000

# ── Live token streaming (Redis pub/sub) ───────────────────────────────
AI_STREAM_TTL_MS=600000
AI_STREAM_MAX_LOG_EVENTS=5000
AI_STREAM_PUBLISH_TIMEOUT_MS=2000
AI_STREAM_SUBSCRIBE_TIMEOUT_MS=5000
AI_STREAM_REDIS_COOLDOWN_MS=30000
# Single-host compose: keep true. Kubernetes web replicas use false and
# deploy/k8s/worker.yaml runs the one GPU-safe worker.
QUEUE_WORKER_ENABLED=true

# ── Legislation ingest ─────────────────────────────────────────────────
# Host path to the scraper output (must exist before `up`). In production a
# missing/empty corpus aborts the ingest unless ALLOW_MOCK_CORPUS=true.
SCRAPED_LAWS_PATH=./scraped_laws.json
ALLOW_MOCK_CORPUS=false

# ── Admin shortcuts ────────────────────────────────────────────────────
ADMIN_MAGIC_LINK_ENABLED=false

# ── Monitoring profile (only needed with --profile monitoring) ─────────
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_GRAFANA_PASSWORD
GRAFANA_PORT=3001
# Alertmanager delivery. Empty Slack channel / placeholder email keeps the
# config loadable; notifications simply fail until real values are set.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
ALERT_EMAIL_TO=alerts@example.com
ALERT_EMAIL_FROM=nomosai-alerts@example.com
SMTP_REQUIRE_TLS=true

# ── Backups ────────────────────────────────────────────────────────────
# The backup sidecar writes pg_dump files to the backups_prod volume. Set
# BACKUP_S3_BUCKET to additionally upload every dump to S3-compatible storage
# before pruning (docs/backup-restore.md). The AWS default credential chain is
# used when S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY are empty.
BACKUP_S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=nomosai/
S3_SSE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1
