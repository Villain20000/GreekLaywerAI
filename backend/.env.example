# NomosAI Backend environment template.
# Copy to `.env` and fill in values. NEVER commit a real .env to the repo.

# --- Server ---
PORT=3000
# Trust proxy hops behind a reverse proxy (nginx/Cloudflare). Default
# 'uniquelocal,loopback' trusts private-network hops; set an explicit
# count or CIDR list for multi-hop chains.
TRUST_PROXY=uniquelocal,loopback

# --- Database (PostgreSQL + pgvector) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=nomos_admin
DB_PASSWORD=nomos_password
DB_NAME=nomos_db

# --- Redis (BullMQ inference queue + rate-limit storage) ---
REDIS_URL=redis://localhost:6379

# --- Ollama (local LLM + embeddings) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024

# --- Auth ---
# REQUIRED in production. Fail-fast at boot if missing/equal to the
# development default. Generate one with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string

# --- Stripe (billing) ---
# Real key starts with sk_live_ or sk_test_. Leave unset (or sk_test_mock)
# to keep the mock checkout used by dev/tests.
STRIPE_SECRET_KEY=sk_test_mock
# Price IDs from the Stripe Dashboard, one per tier:
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
# Webhook signing secret (Stripe CLI: `stripe listen --forward-to ...`)
STRIPE_WEBHOOK_SECRET=

# --- App / frontend ---
APP_BASE_URL=http://localhost:4200
# Comma-separated list of allowed CORS origins (e.g. http://localhost:4200)
CORS_ORIGINS=http://localhost:4200

# --- Email (dev console transport by default) ---
# Production requires EMAIL_TRANSPORT=smtp + SMTP_HOST/PORT/USER/PASS/EMAIL_FROM
# (not yet implemented — console transport refuses to run in production).
EMAIL_TRANSPORT=console
EMAIL_FROM=

# --- Data retention (days; cleanup script backend/src/scripts/retentionCleanup.js) ---
RETENTION_CONVERSATIONS_DAYS=365
RETENTION_DOCUMENTS_DAYS=365
RETENTION_AUDIT_LOG_DAYS=90

# --- Admin magic link (dev shortcut; must be 'true' to enable in production) ---
ADMIN_MAGIC_LINK_ENABLED=false
