# NomosAI Backend environment template.
# Copy to `.env` and fill in values. NEVER commit a real .env to the repo.
#
# Deployment runbooks:
#   docs/production-hardening.md  (TLS, *_FILE secrets, cache, feature flags)
#   docs/observability.md         (Prometheus/Alertmanager/Grafana/Loki)
#   docs/backup-restore.md        (pg_dump, S3 offsite copy, restore)
#   docs/staging-deployment.md    (staging stack)
#
# Every secret may instead be supplied through `<NAME>_FILE` (for example
# JWT_SECRET_FILE=/run/secrets/jwt_secret); the file takes precedence over the
# plain variable and trailing CR/LF is stripped.

# --- Server ---
NODE_ENV=development
PORT=3000
# pino log level (trace|debug|info|warn|error|fatal|silent).
LOG_LEVEL=info
# Trust proxy hops behind a reverse proxy (nginx/Cloudflare). Default
# 'uniquelocal,loopback' trusts private-network hops; set an explicit
# count or CIDR list for multi-hop chains.
TRUST_PROXY=uniquelocal,loopback

# --- Database (PostgreSQL + pgvector) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=nomos_admin
DB_PASSWORD=nomos_password
DB_NAME=nomos_db

# --- Redis (BullMQ inference queue + rate-limit storage) ---
REDIS_URL=redis://localhost:6379

# --- Ollama (local LLM + embeddings) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024
# Chat model pulled in the compose `ollama` service (gemma:2b + use_mmap).
OLLAMA_CHAT_MODEL=gemma2b-mmap
# Hard cap on a single Ollama call (chat, embeddings, warmup). Cold model
# loads on slow hardware can take minutes — raise for CPU-only deployments.
OLLAMA_TIMEOUT_MS=120000
# Optional Ollama vision model (e.g. llava). Empty/disabled → image uploads
# use local Tesseract OCR instead. Nothing is pulled automatically.
OLLAMA_VISION_MODEL=
OLLAMA_VISION_TIMEOUT_MS=120000

# --- Speech-to-text (local whisper sidecar) ---
# OpenAI-compatible whisper server (docker-compose `whisper` service:
# speaches + faster-whisper). Audio is sent ONLY to this URL — the default is
# the local sidecar, so nothing leaves the deployment. Set WHISPER_URL to
# `disabled` (or an empty value) to switch STT off; /api/ai/audio-query then
# returns 503 'Speech-to-text is temporarily unavailable'.
WHISPER_URL=http://127.0.0.1:8000
# Must match a model installed in the sidecar (compose PRELOAD_MODELS).
# `Systran/faster-whisper-base` is the small multilingual default (Greek
# included). `-small` / `-large-v3` are more accurate but much slower on CPU.
WHISPER_MODEL=Systran/faster-whisper-base
# Hard cap on one transcription request. CPU inference runs around real time
# for the base model, so raise this for long recordings.
WHISPER_TIMEOUT_MS=120000

# --- Greek-law retrieval (optional Ansvar MCP gateway) ---
# When credentials are configured, legislation retrieval goes to the Ansvar
# MCP gateway first and automatically falls back to the local pgvector corpus
# on any error. The chat query text leaves the deployment; uploaded documents
# are never sent to Ansvar. Credentials are optional — leaving them empty
# keeps retrieval fully local.
#ANSVAR_MCP_ENABLED=true
#ANSVAR_MCP_URL=https://gateway.ansvar.eu/mcp
# OAuth 2.0 client-credentials client (scope mcp:tools).
#ANSVAR_CLIENT_ID=
#ANSVAR_CLIENT_SECRET=
#ANSVAR_CLIENT_SECRET_FILE=/run/secrets/ansvar_client_secret
# Alternative: a pre-issued bearer token (takes precedence over client creds).
#ANSVAR_MCP_TOKEN=
#ANSVAR_MCP_TOKEN_FILE=/run/secrets/ansvar_mcp_token
#ANSVAR_SCOPE=mcp:tools
#ANSVAR_TOKEN_URL=https://auth.ansvar.eu/realms/ansvar/protocol/openid-connect/token
# Optional: pin the search tool and/or map its arguments explicitly.
#ANSVAR_TOOL_NAME=
#ANSVAR_TOOL_ARGS={"query":"{{query}}","limit":"{{limit}}"}
#ANSVAR_TIMEOUT_MS=20000
#ANSVAR_SESSION_TTL_MS=300000

# --- Auth ---
# REQUIRED in production. Fail-fast at boot if missing/equal to the
# development default. Generate one with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string
#JWT_SECRET_FILE=/run/secrets/jwt_secret

# --- Stripe (billing) ---
# Real key starts with sk_live_ or sk_test_. Leave unset (or sk_test_mock)
# to keep the mock checkout used by dev/tests.
STRIPE_SECRET_KEY=sk_test_mock
#STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
# Price IDs from the Stripe Dashboard, one per tier:
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
# Webhook signing secret (Stripe CLI: `stripe listen --forward-to ...`).
# Register the production endpoint with `npm run stripe:webhook`; it prints
# the signing secret once when it creates the endpoint.
STRIPE_WEBHOOK_SECRET=
#STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret

# --- App / frontend ---
APP_BASE_URL=http://localhost:4200
# Public origin baked into the SPA build (index.html, sitemap.xml, robots.txt)
# by frontend/scripts/apply-site-url.js. Read at build time only.
SITE_URL=https://your-domain.gr
# Comma-separated list of allowed CORS origins (e.g. http://localhost:4200)
CORS_ORIGINS=http://localhost:4200

# --- Account deletion grace period ---
# DELETE /api/gdpr/account schedules deletion this many hours ahead
# (default 24, clamped to 1-168). Users can cancel until the deadline.
ACCOUNT_DELETION_GRACE_HOURS=24

# --- Email ---
# Dev/test default: the 'console' transport prints [DEV-EMAIL] links to
# stdout. Production REQUIRES EMAIL_TRANSPORT=smtp + SMTP_HOST + EMAIL_FROM;
# the backend refuses to boot with NODE_ENV=production otherwise.
# SMTP_USER/SMTP_PASS are optional (unauthenticated relays).
EMAIL_TRANSPORT=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
#SMTP_USER_FILE=/run/secrets/smtp_user
#SMTP_PASS_FILE=/run/secrets/smtp_pass

# --- AI request limits (1-2) ---
# Synchronous /api/ai/query waits on the inference queue; over this budget the
# route returns HTTP 504 (the job may still finish in the background).
AI_QUERY_TIMEOUT_MS=120000
# Per-request upload cap for the AI endpoints (audio/multimodal), in bytes
# (default 25 MB). Oversized uploads return 413 before Ollama is called.
AI_UPLOAD_MAX_BYTES=26214400
# Local OCR fallback for image uploads (Tesseract language packs).
OCR_LANGUAGES=ell+eng
OCR_TIMEOUT_MS=30000
# Scanned-PDF OCR: rasterize up to OCR_PDF_MAX_PAGES pages at OCR_PDF_SCALE
# and share one OCR_PDF_TIMEOUT_MS deadline across rasterization + recognition.
OCR_PDF_MAX_PAGES=10
OCR_PDF_SCALE=2
OCR_PDF_TIMEOUT_MS=120000
# Live SSE token streaming through Redis pub/sub.
AI_STREAM_TTL_MS=600000
AI_STREAM_MAX_LOG_EVENTS=5000
AI_STREAM_PUBLISH_TIMEOUT_MS=2000
AI_STREAM_SUBSCRIBE_TIMEOUT_MS=5000
AI_STREAM_REDIS_COOLDOWN_MS=30000
# Set false on web replicas when a dedicated worker runs the queue.
QUEUE_WORKER_ENABLED=true

# --- Legislation ingest (1-8) ---
# Scraper output consumed by `node src/scripts/ingestLegislation.js`.
# Defaults to <repo-root>/scraped_laws.json when unset; if set but missing the
# script fails loudly instead of silently ingesting mocks. Compose mounts this
# file read-only at /usr/src/app/scraped_laws.json.
SCRAPED_LAWS_PATH=

# --- Daily quotas (1-4) ---
# Per-tier daily AI query caps, matching the billing UI. Quotas reset at
# 00:00 UTC; over-limit requests get HTTP 429 + Retry-After.
# Under NODE_ENV=test the effective cap is 100000 unless a variable below is
# set explicitly (so the jest suite can't trip quotas).
QUOTA_AI_BASIC=20
QUOTA_AI_PRO=60
QUOTA_AI_ENTERPRISE=120
# Per-tier uploaded-document caps (total documents, not per day). Use
# `unlimited` (or `null`) to disable the cap. Over-limit uploads return 403.
QUOTA_DOCS_BASIC=10
QUOTA_DOCS_PRO=50
QUOTA_DOCS_ENTERPRISE=unlimited

# --- Redis response cache (fail-open; see docs/production-hardening.md) ---
RAG_CACHE_TTL_SECONDS=300
PLANS_CACHE_TTL_SECONDS=3600
CACHE_PREFIX=nomos:cache

# --- Feature flags (GET /api/config) ---
# Comma-separated. A bare name enables; name:false disables. Known flags:
# billing, documents, audio, adminDocuments (all default enabled).
FEATURE_FLAGS=

# --- A/B experiments (GET /api/config) ---
# JSON object: {"experiment":{"variants":{"name":weight,...}}}. Client-side
# deterministic assignment by hashed client id; no exposure analytics.
# Empty uses the built-in landing-hero 50/50 control/variant split.
AB_EXPERIMENTS=

# --- Sentry (optional error/performance reporting) ---
# Empty disables the SDK entirely (no network calls).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 0 disables performance tracing; values are clamped to 0..1.
SENTRY_TRACES_SAMPLE_RATE=0
# Frontend Sentry is build-time only: set sentryDsn / sentryTracesSampleRate
# in frontend/src/environments/environment.prod.ts and rebuild the SPA.

# --- Data retention (days; cleanup script backend/src/scripts/retentionCleanup.js) ---
RETENTION_CONVERSATIONS_DAYS=365
RETENTION_DOCUMENTS_DAYS=365
RETENTION_AUDIT_LOG_DAYS=90

# --- Backups (3-3) ---
# Destination for pg_dump files and source directory for restoreDb.js --latest.
# Empty means backend/backups (relative to the backend directory). Production
# compose overrides this with /backups (the backups_prod volume).
BACKUP_DIR=
# Optional S3-compatible offsite copy (docs/backup-restore.md). Leave the
# bucket empty for local-only backups. Prefix must end with `/`.
BACKUP_S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=nomosai/
S3_SSE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The AWS default credential chain is used when the S3_* keys are unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=

# --- Monitoring stack (3-1; docker-compose only, not read by the API) ---
# Grafana is bound to 127.0.0.1:${GRAFANA_PORT:-3001} in both compose files.
# In production reach it through an SSH tunnel or an authenticated proxy.
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
# Directory shared with node_exporter's textfile collector. Compose sets this
# for the backup cron sidecar; empty disables the freshness metric.
PROM_TEXTFILE_DIR=

# --- Edge rate limiting (Traefik labels in docker-compose.prod/staging) ---
# Per-request average/burst (requests per second) and concurrent in-flight
# requests. Long-lived SSE responses count once, not per event.
EDGE_RATE_LIMIT_AVERAGE=50
EDGE_RATE_LIMIT_BURST=100
EDGE_INFLIGHT_REQ_AMOUNT=100

# --- Admin magic link (dev shortcut; must be 'true' to enable in production) ---
ADMIN_MAGIC_LINK_ENABLED=false

# --- Inference queue hardening (Phase 1-14) ---
# Inline (no-Redis) mode: completed jobs are retained briefly so polls can
# still read them, then pruned. Concurrency defaults to 1 to protect the GPU
# on single-worker deployments.
INLINE_JOB_TTL_MS=600000
INLINE_JOB_PRUNE_INTERVAL_MS=60000
INLINE_QUEUE_CONCURRENCY=1
# BullMQ mode: retry/backoff, enqueue timeout, retention and stalled-job
# policy. `removeOnComplete/removeOnFail` keep the most recent N jobs.
INFERENCE_QUEUE_ATTEMPTS=3
INFERENCE_QUEUE_BACKOFF_MS=1000
INFERENCE_QUEUE_ENQUEUE_TIMEOUT_MS=10000
INFERENCE_QUEUE_REMOVE_ON_COMPLETE=1000
INFERENCE_QUEUE_REMOVE_ON_FAIL=5000
INFERENCE_QUEUE_MAX_STALLED_COUNT=1
INFERENCE_QUEUE_LOCK_DURATION_MS=300000
INFERENCE_QUEUE_STALLED_INTERVAL_MS=30000
